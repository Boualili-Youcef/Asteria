flowchart LR
    ExternalUser[Client B2B ou attaquant externe]
    Admin[Administrateur]
    Developer[Developpeur]

    subgraph IDP[Service d identite externe ou partage]
        Identity[OIDC et MFA]
    end

    subgraph DELIVERY[Frontiere supply chain]
        Source[Git]
        CI[CI controlee]
        Registry[Registre par digest]
        Desired[Source de verite CD]
    end

    subgraph PROJECT_TARGET[Projet OpenStack secondaire - staging CAP-05]
        Access[Plan d acces privilegie]
        Edge[Gateway TLS]

        subgraph CLUSTER[Frontiere Kubernetes]
            Policy[Admission et RBAC]

            subgraph NS_ID[Namespace Identity]
                IdentityAPI[identity-api]
            end

            subgraph NS_ORD[Namespace Orders]
                OrdersAPI[orders-api]
            end

            subgraph NS_NOT[Namespace Notifications]
                Worker[notifications-worker]
            end

            subgraph NS_DATA[Frontiere services data]
                Cache[Cache]
                Bus[Bus durable]
            end

            subgraph NS_OBS[Frontiere observabilite]
                Telemetry[Metrics logs traces et audit]
            end

            Secrets[Plan de secrets]
        end

        Postgres[(PostgreSQL)]
    end

    subgraph RECOVERY[Domaine logique de sauvegarde distinct]
        Backup[Backups chiffres et catalogue]
    end

    subgraph PROJECT_SOURCE[Projet OpenStack source - production-like]
        Existing[Plateforme AS-IS preservee jusqu a T17]
        Future[Cluster source reconstruit apres repetition staging]
    end

    ExternalUser -->|TB-01 reseau non fiable| Edge
    ExternalUser -->|TB-02 jeton et tenant| Identity
    Edge -->|TB-03 edge vers workloads| IdentityAPI
    Edge -->|TB-03 edge vers workloads| OrdersAPI
    Identity -->|TB-02 identite verifiee| Edge

    OrdersAPI -->|TB-04 flux data explicite| Postgres
    IdentityAPI -->|TB-04 flux data explicite| Postgres
    Worker -->|TB-04 flux data explicite| Postgres
    OrdersAPI -->|TB-04 cache et evenement| Cache
    OrdersAPI -->|TB-04 evenement durable| Bus
    Bus -->|TB-04 consommation| Worker

    Admin -->|TB-05 identite privilegiee| Identity
    Identity --> Access
    Access -->|TB-05 session courte auditee| CLUSTER
    Access -->|TB-05 session courte auditee| Postgres

    Developer -->|TB-06 changement revu| Source
    Source --> CI --> Registry
    CI --> Desired
    Desired -->|TB-06 reconciliation| CLUSTER
    Registry -->|TB-06 artefact verifie| CLUSTER

    Secrets -->|TB-07 secret court et limite| IdentityAPI
    Secrets -->|TB-07 secret court et limite| OrdersAPI
    Secrets -->|TB-07 secret court et limite| Worker
    Policy -. controle admission .-> NS_ID
    Policy -. controle admission .-> NS_ORD
    Policy -. controle admission .-> NS_NOT

    CLUSTER -->|TB-08 telemetrie minimisee| Telemetry
    Postgres -->|TB-08 telemetrie minimisee| Telemetry
    Postgres -->|TB-09 sauvegarde chiffree| Backup
    Secrets -->|TB-09 snapshot chiffre| Backup
    CLUSTER -->|TB-09 etat recuperable| Backup

    Existing <-.->|TB-10 aucun transit implicite| PROJECT_TARGET
    Existing -. migration controlee .-> Future

