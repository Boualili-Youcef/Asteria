    classDef security fill:#f3e8ff,stroke:#7e22ce,color:#581c87;
    classDef external fill:#fef3c7,stroke:#b45309,color:#78350f;
    classDef note fill:#f3f4f6,stroke:#4b5563,color:#111827;
    class Current,PG source;
    class Future,StageCP,StageWorker,Cilium,Envoy,Argo,Policy,StageApps,Cache,Bus,Obs target;
    class GitHubId,AppId,Bastion,Secrets,Identity security;
    class GitHub,GHCR,ExternalS3 external;
    class Approved,Rollback note;
